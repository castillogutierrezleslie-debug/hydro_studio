# Datos de conexion a tu base de datos MySQL de Hostinger.
# Los encuentras en hPanel > Bases de datos > (tu base de datos) > Detalles de conexion.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nombre_de_tu_base_de_datos
DB_USER=usuario_mysql
DB_PASSWORD=CAMBIA_ESTA_CLAVE_123!

# Puerto en el que corre el servidor Node.js. Hostinger suele asignar
# esto automaticamente al desplegar la app -- si tu panel te da un
# puerto especifico, ponlo aqui.
PORT=3000

# Para las funciones de IA en el boton Inteligencia (opcional).
# Consigue tu propia clave en https://console.anthropic.com -- nunca la compartas
# ni la subas a GitHub. Sin esta clave, los botones de IA muestran un aviso claro
# en vez de fallar en silencio.
ANTHROPIC_API_KEY=
